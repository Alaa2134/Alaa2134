# Copy to .env for local runs:  cp .env.example .env
# Never commit your real .env file.

# --- Instagram Graph API (required to publish) ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- GitHub (required to host the video as a public Release asset) ---
# In GitHub Actions these are provided automatically; only set them for local runs.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo
RELEASE_TAG=daily-reels

# --- Content options ---
AUDIO_EDITION=ar.alafasy
SELECTION_MODE=sequential
# VERSE_REFERENCE=2:255

# --- Caption ---
CAPTION_HASHTAGS=#قرآن #قران_كريم #تلاوة #اسلام #quran #islam #recitation #reels

# --- Behaviour ---
# DRY_RUN=true  # generate the video only, no upload/publish

# --- Optional font override ---
# QURAN_FONT=/path/to/ArabicFont.ttf
